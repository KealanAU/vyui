{
  "name": "@vyui/kit",
  "type": "module",
  "version": "0.3.3",
  "description": "Styled Vue-Lynx components built on @vyui/core",
  "license": "MIT",
  "author": "Kealan Clarke",
  "homepage": "https://vyui.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KealanAU/vyui.git",
    "directory": "packages/kit"
  },
  "bugs": {
    "url": "https://github.com/KealanAU/vyui/issues"
  },
  "keywords": [
    "vue",
    "lynx",
    "vue-lynx",
    "native",
    "mobile",
    "ui",
    "components",
    "design-system",
    "tailwind",
    "tailwind-variants"
  ],
  "//sideEffects": "Must mirror packages/core. @vyui/kit has no `'main thread'` worklets of its own, but its components transitively import @vyui/core components/composables (TrayView->useDragGesture, useAnimate, Sheet, ...) that DO register main-thread worklets. With `sideEffects: false`, vue-lynx's MT side-effect imports (`import '@vyui/kit'` emitted by worklet-loader-mt) get elided, so those transitive core worklets never register and downstream consumers crash with `bind of undefined`. Keep this widened whether or not kit adds its own worklets.",
  "sideEffects": [
    "**/*.css",
    "**/*.vue.js",
    "dist/**/*.js"
  ],
  "files": [
    "dist",
    "src/style.css",
    "scripts/gen-colors.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm build-only && pnpm smoke-test",
    "build-only": "vite build && node scripts/gen-subpath-entries.mjs && node ../shared-build-config/scripts/rewrite-deep-imports.mjs dist @vyui/core ../core/dist/index.js && node ../shared-build-config/scripts/check-dist-shape.mjs dist && vue-tsc -p tsconfig.build.json && pnpm copy-dts && node ../shared-build-config/scripts/add-dts-extensions.mjs dist && node ../shared-build-config/scripts/check-dts.mjs dist",
    "copy-dts": "cp src/tailwind.d.ts dist/tailwind.d.ts && cp src/config.d.ts dist/config.d.ts && cp src/theme/color-constants.d.ts dist/theme/color-constants.d.ts",
    "smoke-test": "node scripts/smoke-test.mjs",
    "test": "vitest run",
    "test-watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src"
  },
