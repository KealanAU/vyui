{
  "name": "create-vyui",
  "type": "module",
  "version": "0.1.0",
  "description": "Scaffold a Vue-Lynx + Vy UI app with all wiring done (Tailwind preset, worklets, providers, overlay hosts)",
  "license": "MIT",
  "author": "Kealan Clarke",
  "homepage": "https://vyui.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KealanAU/vyui.git",
    "directory": "packages/create-vyui"
  },
  "bugs": {
    "url": "https://github.com/KealanAU/vyui/issues"
  },
  "keywords": [
    "vue",
