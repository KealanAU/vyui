{
  "name": "@vyui/cli",
  "type": "module",
  "version": "0.1.4",
  "description": "shadcn-style CLI for adding @vyui/kit styled components to a project",
  "license": "MIT",
  "author": "Kealan Clarke",
  "homepage": "https://vyui.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KealanAU/vyui.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/KealanAU/vyui/issues"
  },
  "keywords": [
    "vue",
    "lynx",
    "vue-lynx",
    "native",
    "mobile",
    "ui",
    "components",
    "cli",
    "registry"
  ],
  "bin": {
    "vyui": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "^8.0.0",
    "vitest": "catalog:"
  }
}
