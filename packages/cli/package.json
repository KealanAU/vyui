{
  "name": "@vyui/cli",
  "version": "0.0.0",
  "description": "shadcn-style CLI for adding @vyui/kit styled components to a project",
  "type": "module",
  "bin": {
    "vyui": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.0.0",
    "vitest": "^3.2.4"
  }
}
