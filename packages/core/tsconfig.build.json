{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "types": []
  },
  "include": [
    "env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.test.vue",
    "src/__type-guards__/**",
    "src/test-utils.ts",
    "src/test/**",
    "src/**/*.story.vue",
    "src/**/story/**",
    "src/**/_*.vue"
  ]
}
