{"source":"<script setup lang=\"ts\">\nimport { ref } from 'vue'\nimport { VyIcon } from '@vyui/kit/icon'\nimport { VySwipeAction } from '@vyui/kit/swipe-action'\n\nconst open = ref(false)\nconst archived = ref(false)\n</script>\n\n<template>\n  <view class=\"w-full\">\n    <VySwipeAction\n      v-if=\"!archived\"\n      v-model:open=\"open\"\n      :row-width=\"360\"\n      :action-width=\"96\"\n      @commit=\"archived = true\"\n    >\n      <view class=\"h-16 px-4 justify-center bg-white\">\n        <text class=\"font-medium\">Quarterly report</text>\n        <text class=\"text-sm text-neutral-500\">Swipe left to archive</text>\n      </view>\n\n      <template #actions=\"{ close }\">\n        <view\n          class=\"w-24 items-center justify-center bg-primary-600\"\n          accessibility-element=\"true\"\n          accessibility-traits=\"button\"\n          @tap=\"archived = true; close()\"\n        >\n          <VyIcon name=\"i-lucide-archive\" class=\"text-white\" />\n        </view>\n      </template>\n    </VySwipeAction>\n\n    <view v-else class=\"h-16 px-4 justify-center\">\n      <text class=\"text-sm text-neutral-500\">Archived.</text>\n    </view>\n  </view>\n</template>","highlighted":"<pre class=\"shiki material-theme-palenight\" style=\"background-color:#292D3E;color:#babed8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#89DDFF\">&#x3C;</span><span style=\"color:#F07178\">script</span><span style=\"color:#C792EA\"> setup</span><span style=\"color:#C792EA\"> lang</span><span style=\"color:#89DDFF\">=</span><span style=\"color:#89DDFF\">\"</span><span style=\"color:#C3E88D\">ts</span><span style=\"color:#89DDFF\">\"</span><span style=\"color:#89DDFF\">></span></span>\n<span class=\"line\"><span style=\"color:#89DDFF;font-style:italic\">import</span><span style=\"color:#89DDFF\"> {</span><span style=\"color:#BABED8\"> ref</span><span style=\"color:#89DDFF\"> }</span><span style=\"color:#89DDFF;font-style:italic\"> from</span><span 