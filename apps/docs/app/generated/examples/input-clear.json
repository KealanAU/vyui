{"source":"<script setup lang=\"ts\">\nimport { ref } from 'vue'\nimport { VyButton } from '@vyui/kit/button'\nimport { VyInput } from '@vyui/kit/input'\n\nconst value = ref('Click to clear')\n</script>\n\n<template>\n  <VyInput\n    v-model=\"value\"\n    placeholder=\"Type something...\"\n    class=\"w-[280px]\"\n  >\n    <template v-if=\"value.length\" #trailing>\n      <VyButton\n        size=\"xs\"\n        variant=\"ghost\"\n        color=\"neutral\"\n        icon=\"i-lucide-circle-x\"\n        label=\"Clear\"\n        @tap=\"value = ''\"\n      />\n    </template>\n  </VyInput>\n</template>","highlighted":"<pre class=\"shiki material-theme-palenight\" style=\"background-color:#292D3E;color:#babed8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#89DDFF\">&#x3C;</span><span style=\"color:#F07178\">script</span><span style=\"color:#C792EA\"> setup</span><span style=\"color:#C792EA\"> lang</span><span style=\"color:#89DDFF\">=</span><span style=\"color:#89DDFF\">\"</span><span style=\"color:#C3E88D\">ts</span><span style=\"color:#89DDFF\">\"</span><span style=\"color:#89DDFF\">></span></span>\n<span class=\"line\"><span style=\"color:#89DDFF;font-style:italic\">import</span><span style=\"color:#89DDFF\"> {</span><span style=\"color:#BABED8\"> ref</span><span style=\"color:#89DDFF\"> }</span><span style=\"color:#89DDFF;font-style:italic\"> from</span><span style=\"color:#89DDFF\"> '</span><span style=\"color:#C3E88D\">vue</span><span style=\"color:#89DDFF\">'</span></span>\n<span class=\"line\"><span style=\"color:#89DDFF;font-style:italic\">import</span><span style=\"color:#89DDFF\"> {</span><span style=\"color:#BABED8\"> VyButton</span><span style=\"color:#89DDFF\"> }</span><span style=\"color:#89DDFF;font-style:italic\"> from</span><span style=\"color:#89DDFF\"> '</span><span style=\"color:#C3E88D\">@vyui/kit/button</span><span style=\"color:#89DDFF\">'</span></span>\n<span class=\"line\"><span style=\"color:#89DDFF;font-style:italic\">import</