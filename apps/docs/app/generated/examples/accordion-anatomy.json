9DDFF\">,</span><span style=\"color:#F07178\"> content</span><span style=\"color:#89DDFF\">:</span><span style=\"color:#89DDFF\"> '</span><span style=\"color:#C3E88D\">You have nothing to do, the icon set handles it automatically.</span><span style=\"color:#89DDFF\">'</span><span style=\"color:#89DDFF\"> },</span></span>\n<span class=\"line\"><span style=\"color:#89DDFF\">  {</span><span style=\"color:#F07178\"> value</span><span style=\"color:#89DDFF\">:</span><span style=\"color:#89DDFF\"> '</span><span style=\"color:#C3E88D\">colors</span><span style=\"color:#89DDFF\">'</span><span style=\"color:#89DDFF\">,</span><span style=\"color:#F07178\"> label</span><span style=\"color:#89DDFF\">:</span><span style=\"color:#89DDFF\"> '</span><span style=\"color:#C3E88D\">Colors</span><span style=\"color:#89DDFF\">'</span><span style=\"color:#89DDFF\">,</span><span style=\"color:#F07178\"> content</span><span style=\"color:#89DDFF\">:</span><span style=\"color:#89DDFF\"> '</span><span style=\"color:#C3E88D\">Choose a primary and a neutral color from your theme.</span><span style=\"color:#89DDFF\">'</span><span style=\"color:#89DDFF\"> },</span></span>\n<span class=\"line\"><span style=\"color:#BABED8\">]</span></span>\n<span class=\"line\"><span style=\"color:#89DDFF\">&#x3C;/</span><span style=\"color:#F07178\">script</span><span style=\"color:#89DDFF\">></span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#89DDFF\">&#x3C;</span><span style=\"color:#F07178\">template</span><span style=\"color:#89DDFF\">></span></span>\n<span class=\"line\"><span style=\"color:#89DDFF\">  &#x3C;</span><span style=\"color:#F07178\">AccordionRoot</span></span>\n<span class=\"line\"><span style=\"color:#C792EA\">    type</span><span style=\"color:#89DDFF\">=</span><span style=\"color:#89DDFF\">\"</span><span style=\"color:#C3E88D\">single</span><span style=\"color:#89DDFF\">\"</span></span>\n<span class=\"line\"><span style=\"color:#C792EA\">    :collapsible</s