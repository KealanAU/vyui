{"source":"<script setup lang=\"ts\">\n// The @vyui/core primitives that VyAccordion is built on. Use these directly\n// when you need full control over markup and styling.\nimport {\n  AccordionContent,\n  AccordionHeader,\n  AccordionItem,\n  AccordionRoot,\n  AccordionTrigger,\n} from '@vyui/core'\n\nconst items = [\n  { value: 'icons', label: 'Icons', content: 'You have nothing to do, the icon set handles it automatically.' },\n  { value: 'colors', label: 'Colors', content: 'Choose a primary and a neutral color from your theme.' },\n]\n</script>\n\n<template>\n  <AccordionRoot\n    type=\"single\"\n    :collapsible=\"true\"\n    default-value=\"icons\"\n    class=\"w-[320px] rounded-lg border border-neutral-200 bg-white overflow-hidden\"\n  >\n    <AccordionItem\n      v-for=\"item in items\"\n      :key=\"item.value\"\n      :value=\"item.value\"\n      class=\"border-b border-neutral-200\"\n    >\n      <AccordionHeader>\n        <AccordionTrigger class=\"flex flex-row items-center justify-between w-full px-4 py-3\">\n          <text class=\"text-sm font-medium text-neutral-900\">{{ item.label }}</text>\n          <text class=\"text-neutral-400\">+</text>\n        </AccordionTrigger>\n      </AccordionHeader>\n      <AccordionContent class=\"px-4 pb-3\">\n        <text class=\"text-sm text-neutral-500\">{{ item.content }}</text>\n      </AccordionContent>\n    </AccordionItem>\n  </AccordionRoot>\n</template>","highlighted":"<pre class=\"shiki material-theme-palenight\" style=\"background-color:#292D3E;color:#babed8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#89DDFF\">&#x3C;</span><span style=\"color:#F07178\">script</span><span style=\"color:#C792EA\"> setup</span><span style=\"color:#C792EA\"> lang</span><span style=\"color:#89DDFF\">=</span><span style=\"color:#89DDFF\">\"</span><span style=\"color:#C3E88D\">ts</span><span style=\"color:#89DDFF\">\"</span><span style=\"color:#89DDFF\">></span></span>\n<span class=\"line\"><span style=\"