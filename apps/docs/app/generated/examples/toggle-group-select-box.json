{"source":"<script setup lang=\"ts\">\nimport { ref } from 'vue'\nimport { VyIcon } from '@vyui/kit/icon'\nimport { VyToggleGroup } from '@vyui/kit/toggle-group'\n\nconst plan = ref('pro')\nconst plans = [\n  { label: 'Starter', value: 'starter', description: 'Up to 3 projects' },\n  { label: 'Pro', value: 'pro', description: 'Unlimited projects and history' },\n  { label: 'Team', value: 'team', description: 'Shared workspaces and roles' },\n]\n</script>\n\n<template>\n  <VyToggleGroup\n    v-model=\"plan\"\n    type=\"single\"\n    orientation=\"vertical\"\n    :items=\"plans\"\n    :ui=\"{ root: 'gap-2 space-y-0', item: 'rounded-md p-4' }\"\n  >\n    <template #default=\"{ item, iconColor }\">\n      <view class=\"flex flex-row items-center justify-between w-full\">\n        <view class=\"flex flex-col\">\n          <text class=\"font-medium text-default group-ui-on:text-primary-600\">\n            {{ item.label }}\n          </text>\n          <text class=\"text-xs text-muted\">\n            {{ item.description }}\n          </text>\n        </view>\n        <VyIcon\n          v-if=\"plan === item.value\"\n          name=\"i-lucide-check\"\n          :size=\"20\"\n          :color=\"iconColor\"\n        />\n      </view>\n    </template>\n  </VyToggleGroup>\n</template>","highlighted":"<pre class=\"shiki material-theme-palenight\" style=\"background-color:#292D3E;color:#babed8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#89DDFF\">&#x3C;</span><span style=\"color:#F07178\">script</span><span style=\"color:#C792EA\"> setup</span><span style=\"color:#C792EA\"> lang</span><span style=\"color:#89DDFF\">=</span><span style=\"color:#89DDFF\">\"</span><span style=\"color:#C3E88D\">ts</span><span style=\"color:#89DDFF\">\"</span><span style=\"color:#89DDFF\">></span></span>\n<span class=\"line\"><span style=\"color:#89DDFF;font-style:italic\">import</span><span style=\"color:#89DDFF\"> {</span><span style=\"color:#BABED8\"> ref</span><span style=\"colo