an><span style=\"color:#89DDFF\"> '</span><span style=\"color:#C3E88D\">Katherine Johnson</span><span style=\"color:#89DDFF\">'</span><span style=\"color:#89DDFF\">,</span><span style=\"color:#F07178\"> text</span><span style=\"color:#89DDFF\">:</span><span style=\"color:#89DDFF\"> '</span><span style=\"color:#C3E88D\">KJ</span><span style=\"color:#89DDFF\">'</span><span style=\"color:#89DDFF\"> },</span></span>\n<span class=\"line\"><span style=\"color:#89DDFF\">  {</span><span style=\"color:#F07178\"> name</span><span style=\"color:#89DDFF\">:</span><span style=\"color:#89DDFF\"> '</span><span style=\"color:#C3E88D\">Alan Turing</span><span style=\"color:#89DDFF\">'</span><span style=\"color:#89DDFF\">,</span><span style=\"color:#F07178\"> text</span><span style=\"color:#89DDFF\">:</span><span style=\"color:#89DDFF\"> '</span><span style=\"color:#C3E88D\">AT</span><span style=\"color:#89DDFF\">'</span><span style=\"color:#89DDFF\"> },</span></span>\n<span class=\"line\"><span style=\"color:#BABED8\">]</span></span>\n<span class=\"line\"><span style=\"color:#89DDFF\">&#x3C;/</span><span style=\"color:#F07178\">script</span><span style=\"color:#89DDFF\">></span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#89DDFF\">&#x3C;</span><span style=\"color:#F07178\">template</span><span style=\"color:#89DDFF\">></span></span>\n<span class=\"line\"><span style=\"color:#89DDFF\">  &#x3C;</span><span style=\"color:#F07178\">VyAvatarGroup</span><span style=\"color:#C792EA\"> size</span><span style=\"color:#89DDFF\">=</span><span style=\"color:#89DDFF\">\"</span><span style=\"color:#C3E88D\">lg</span><span style=\"color:#89DDFF\">\"</span><span style=\"color:#C792EA\"> color</span><span style=\"color:#89DDFF\">=</span><span style=\"color:#89DDFF\">\"</span><span style=\"color:#C3E88D\">primary</span><span style=\"color:#89DDFF\">\"</span><span style=\"color:#C792EA\"> :max</span><span style=\"color:#89DDFF\">=</span><span style=\"color:#89DDFF\">\"</span><span style=\"color:#C3E88D\">3</span><span style=\"color:#89DDFF\">\"</span><span style=\"color:#89DDFF\">></span></span>\n<span class=\"line\"><span style=\"color:#89DDFF\">    &#x3C;</span><span style=\"color:#F07178\">VyAvatar</span></span>\n<span class=\"line\"><span style=\"color:#C792EA\">      v-for</span><span style=\"color:#89DDFF\">=</span><span style=\"color:#89DDFF\">\"</span><span style=\"color:#C3E88D\">person in people</span><span style=\"color:#89DDFF\">\"</span></span>\n<span class=\"line\"><span style=\"color:#C792EA\">      :key</span><span style=\"color:#89DDFF\">=</span><span style=\"color:#89DDFF\">\"</span><span style=\"color:#C3E88D\">person.name</span><span style=\"color:#89DDFF\">\"</span></span>\n<span class=\"line\"><span style=\"color:#C792EA\">      :text</span><span style=\"color:#89DDFF\">=</span><span style=\"color:#89DDFF\">\"</span><span style=\"color:#C3E88D\">person.text</span><span style=\"color:#89DDFF\">\"</span></span>\n<span class=\"line\"><span style=\"color:#C792EA\">      :alt</span><span style=\"color:#89DDFF\">=</span><span style=\"color:#89DDFF\">\"</span><span style=\"color:#C3E88D\">person.name</span><span style=\"color:#89DDFF\">\"</span></span>\n<span class=\"line\"><span style=\"color:#89DDFF\">    /></span></span>\n<span class=\"line\"><span style=\"color:#89DDFF\">  &#x3C;/</span><span style=\"color:#F07178\">VyAvatarGroup</span><span style=\"color:#89DDFF\">></span></span>\n<span class=\"line\"><span style=\"color:#89DDFF\">&#x3C;/</span><span style=\"color:#F07178\">template</span><span style=\"color:#89DDFF\">></span></span></code></pre>"}