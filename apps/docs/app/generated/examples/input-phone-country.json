{"source":"<script setup lang=\"ts\">\nimport { computed, ref, watch } from 'vue'\nimport { VyInput } from '@vyui/kit/input'\nimport { VySelect } from '@vyui/kit/select'\n\ntype PhoneCode = {\n  name: string\n  code: string\n  emoji: string\n  dialCode: string\n  mask: string\n}\n\nconst phoneCodes: PhoneCode[] = [\n  { name: 'United States', code: 'US', emoji: '\\u{1F1FA}\\u{1F1F8}', dialCode: '+1', mask: '(###) ###-####' },\n  { name: 'United Kingdom', code: 'GB', emoji: '\\u{1F1EC}\\u{1F1E7}', dialCode: '+44', mask: '#### ### ####' },\n  { name: 'Sweden', code: 'SE', emoji: '\\u{1F1F8}\\u{1F1EA}', dialCode: '+46', mask: '## ### ## ##' },\n  { name: 'Australia', code: 'AU', emoji: '\\u{1F1E6}\\u{1F1FA}', dialCode: '+61', mask: '### ### ###' },\n]\n\nconst phone = ref('')\nconst countryCode = ref('US')\n\nconst country = computed(() => phoneCodes.find(c => c.code === countryCode.value) ?? phoneCodes[0])\nconst placeholder = computed(() => country.value.mask.replaceAll('#', '_'))\n\nfunction formatItem(item: PhoneCode | string | number) {\n  if (typeof item !== 'object' || item === null) return String(item)\n  return `${item.name} (${item.dialCode})`\n}\n\nwatch(countryCode, () => {\n  phone.value = ''\n})\n</script>\n\n<template>\n  <view class=\"flex flex-row items-center gap-2 w-[320px]\">\n    <VySelect\n      v-model=\"countryCode\"\n      :items=\"phoneCodes\"\n      value-key=\"code\"\n      label-key=\"name\"\n      trailing-icon=\"i-lucide-chevrons-up-down\"\n      :snap-points=\"[0.65]\"\n      class=\"w-[86px]\"\n      :ui=\"{ value: 'hidden', placeholder: 'hidden', trailingIcon: 'size-4' }\"\n    >\n      <template #default>\n        <text class=\"text-lg\">{{ country.emoji }}</text>\n      </template>\n\n      <template #item-leading=\"{ item }\">\n        <text v-if=\"typeof item === 'object' && item !== null\" class=\"text-lg\">{{ item.emoji }}</text>\n      </template>\n\n      <template #item-label=\"{ item }\">\n        {{ formatItem(item) }}\n      </template>\n    </VySelect>\n\n    <VyInput\n      v-model=\"phone\"\n      type=\"tel\"\n      :placeholder=\"placeholder\"\n      class=\"flex-1\"\n    >\n      <template #leading>\n        <text class=\"text-sm text-neutral-500\">{{ country.dialCode }}</text>\n      </template>\n    </VyInput>\n  </view>\n</template>","highlighted":"<pre class=\"shiki material-theme-palenight\" style=\"background-color:#292D3E;color:#babed8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#89DDFF\">&#x3C;</span><span style=\"color:#F07178\">script</span><span style=\"color:#C792EA\"> setup</span><span style=\"color:#C792EA\"> lang</span><span style=\"color:#89DDFF\">=</span><span style=\"color:#89DDFF\">\"</span><span style=\"color:#C3E88D\">ts</span><span style=\"color:#89DDFF\">\"</span><span style=\"color:#89DDFF\">></span></span>\n<span class=\"line\"><span style=\"color:#89DDFF;font-style:italic\">import</span><span style=\"color:#89DDFF\"> {</span><span style=\"color:#BABED8\"> computed</span><span style=\"color:#89DDFF\">,</span><span style=\"color:#BABED8\"> ref</span><span style=\"color:#89DDFF\">,</span><span style=\"color:#BABED8\"> watch</span><span style=\"color:#89DDFF\"> }</span><span style=\"color:#89DDFF;font-style:italic\"> from</span><span style=\"color:#89DDFF\"> '</span><span style=\"color:#C3E88D\">vue</span><span style=\"color:#89DDFF\">'</span></span>\n<span class=\"line\"><span style=\"color:#89DDFF;font-style:italic\">import</span><span style=\"color:#89DDFF\"> {</span><span style=\"color:#BABED8\"> VyInput</span><span style=\"color:#89DDFF\"> }</span><span style=\"color:#89DDFF;font-style:italic\"> from</span><span style=\"color:#89DDFF\"> '</span><span style=\"color:#C3E88D\">@vyui/kit/input</span><span style=\"color:#89DDFF\">'</span></span>\n<span class=\"line\"><span style=\"color:#89DDFF;font-style:italic\">import</span><span style=\"color:#89DDFF\"> {</span><span style=\"color:#BABED8\"> VySelect</span><span style=\"color:#89DDFF