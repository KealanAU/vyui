{
  "name": "@vyui/docs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm gen:registry && pnpm playground:build && nuxt dev",
    "dev:fast": "nuxt dev",
    "build": "pnpm gen:registry && pnpm playground:build && nuxt build",
    "generate": "pnpm gen:registry && pnpm playground:build && nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "playground:build": "tsx ../../tools/gen-playground-registry.ts && pnpm --filter @vyui/docs-playground build && tsx ../../tools/sync-playground.ts",
    "gen:registry": "tsx ../../tools/gen-registry.ts",
    "gen:api": "tsx ../../tools/gen-component-api.ts"
  },
  "dependencies": {
    "@iconify-json/lucide": "catalog:",
    "@iconify-json/simple-icons": "^1.2.30",
    "@lynx-js/lynx-core": "0.1.3",
    "@lynx-js/web-core": "0.20.4",
    "@nuxt/content": "^3.14.0",
    "@nuxt/image": "^2.0.0",
    "@nuxt/ui": "^4.0.0",
    "@vueuse/core": "^14.3.0",
    "nuxt": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "vue": "catalog:",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@nuxtjs/sitemap": "^8.2.1",
    "@takumi-rs/core": "^1.8.7",
    "@takumi-rs/helpers": "^1.8.7",
    "better-sqlite3": "^12.10.0",
    "nuxt-llms": "^0.2.0",
    "nuxt-og-image": "^6.6.0",
    "nuxt-schema-org": "^6.2.3",
    "vue-tsc": "catalog:"
  }
