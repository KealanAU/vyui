{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vyui.dev/registry-styles.json",
  "title": "vyui registry styles",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry",
    "default",
    "styles"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "registry": {
      "type": "string",
      "minLength": 1
    },
    "default": {
      "type": "string",
      "minLength": 1
    },
    "styles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    }
  }
}
