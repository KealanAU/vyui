{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vyui.dev/registry-index.json",
  "title": "vyui registry index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry",
    "style",
    "components"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "registry": {
      "type": "string",
      "minLength": 1
    },
    "style": {
      "type": "string",
      "minLength": 1
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "type",
          "dependencies",
          "registryDependencies"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "type": {
            "const": "registry:ui"
          },
          "dependencies": {
            "$ref": "#/$defs/stringArray"
          },
          "registryDependencies": {
            "$ref": "#/$defs/stringArray"
          }
        }
      }
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
