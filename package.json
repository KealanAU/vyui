{
  "name": "@vyui/root",
  "private": true,
  "license": "MIT AND Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "pnpm -r run dev",
    "build": "pnpm gen:api && pnpm -r --filter='./packages/*' build",
    "test": "pnpm -r run test",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r exec rm -rf dist .rspeedy node_modules/.cache && rm -rf node_modules/.cache",
    "check:docs": "tsx tools/check-docs-coverage.ts",
    "check:exports": "pnpm check:exports:core && pnpm check:exports:kit",
    "check:exports:core": "pnpm dlx @arethetypeswrong/cli@0.18.5 --pack packages/core",
    "check:exports:kit": "pnpm dlx @arethetypeswrong/cli@0.18.5 --pack packages/kit",
    "changeset": "changeset",
    "version-packages": "changeset version && tsx tools/gen-changelog-docs.ts",
    "release": "pnpm build && changeset publish",
    "new-component": "tsx tools/make-component.ts",
    "gen:registry": "tsx tools/gen-registry.ts",
    "gen:schemas": "tsx tools/gen-schemas.ts",
    "gen:api": "tsx tools/gen-component-api.ts"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@eslint/js": "^10.0.1",
    "@svitejs/changesets-changelog-github-compact": "^1.2.0",
    "@vue/compiler-sfc": "catalog:",
    "es-module-lexer": "^2.1.0",
    "eslint": "catalog:",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "shiki": "^4.1.0",
    "tsx": "^4.19.2",
    "typescript": "catalog:",
    "typescript-eslint": "^8.62.0",
    "vue-component-meta": "catalog:",
    "vue-eslint-parser": "^10.4.1"
  }
}
